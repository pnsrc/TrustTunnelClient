<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        FireTunnel brand — Deep Orange seed for Material You fallback.
        On Android 12+ DynamicColors.applyToActivitiesIfAvailable() replaces
        these with wallpaper-derived tones automatically.
    -->
    <color name="fire_primary">#C94B1A</color>
    <color name="fire_on_primary">#FFFFFF</color>
    <color name="fire_primary_container">#FFDBCF</color>
    <color name="fire_on_primary_container">#380C00</color>

    <color name="fire_secondary">#775850</color>
    <color name="fire_on_secondary">#FFFFFF</color>
    <color name="fire_secondary_container">#FFD9D2</color>
    <color name="fire_on_secondary_container">#2C1511</color>

    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- Connection status (fixed hues: not replaced by dynamic colour) -->
    <color name="status_ok">#1D7348</color>
    <color name="status_ok_container">#DDF1E5</color>
    <color name="status_on_ok">#FFFFFF</color>
    <color name="status_on_ok_container">#0E4F2F</color>
    <color name="status_warn">#9A5B00</color>
    <color name="status_warn_container">#FCEBCF</color>

    <!-- Launcher icon background (brand orange, not replaced by dynamic colour) -->
    <color name="ic_launcher_background">#C94B1A</color>
</resources>
