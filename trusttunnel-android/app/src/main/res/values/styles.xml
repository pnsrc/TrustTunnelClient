<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme: Material 3 DayNight (auto light/dark).
        On Android 12+ DynamicColors overlays wallpaper-derived tones at runtime.
        The color attributes below serve as the fallback for older devices.
    -->
    <style name="Theme.FireTunnel" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fire_primary</item>
        <item name="colorOnPrimary">@color/fire_on_primary</item>
        <item name="colorPrimaryContainer">@color/fire_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/fire_on_primary_container</item>
        <item name="colorSecondary">@color/fire_secondary</item>
        <item name="colorOnSecondary">@color/fire_on_secondary</item>
        <item name="colorSecondaryContainer">@color/fire_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/fire_on_secondary_container</item>
    </style>

    <!-- Settings screen: section label, card and divider between rows -->
    <style name="SettingsSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">32dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="SettingsCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">56dp</item>
        <item name="dividerColor">?attr/colorOutlineVariant</item>
    </style>

    <!-- About section row styles -->
    <style name="AboutRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="AboutRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="AboutRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="AboutDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
    </style>

    <!-- Palette overlays applied by ThemedActivity (Settings → Appearance) -->
    <style name="ThemeOverlay.FireTunnel.Fire" parent="" />
    <style name="ThemeOverlay.FireTunnel.Ocean" parent="">
        <item name="colorPrimary">@color/pal_ocean_primary</item>
        <item name="colorOnPrimary">@color/pal_ocean_on_primary</item>
        <item name="colorPrimaryContainer">@color/pal_ocean_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/pal_ocean_on_primary_container</item>
        <item name="colorSecondary">@color/pal_ocean_secondary</item>
        <item name="colorOnSecondary">@color/pal_ocean_on_secondary</item>
        <item name="colorSecondaryContainer">@color/pal_ocean_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/pal_ocean_on_secondary_container</item>
    </style>
    <style name="ThemeOverlay.FireTunnel.Forest" parent="">
        <item name="colorPrimary">@color/pal_forest_primary</item>
        <item name="colorOnPrimary">@color/pal_forest_on_primary</item>
        <item name="colorPrimaryContainer">@color/pal_forest_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/pal_forest_on_primary_container</item>
        <item name="colorSecondary">@color/pal_forest_secondary</item>
        <item name="colorOnSecondary">@color/pal_forest_on_secondary</item>
        <item name="colorSecondaryContainer">@color/pal_forest_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/pal_forest_on_secondary_container</item>
    </style>
    <style name="ThemeOverlay.FireTunnel.Amethyst" parent="">
        <item name="colorPrimary">@color/pal_amethyst_primary</item>
        <item name="colorOnPrimary">@color/pal_amethyst_on_primary</item>
        <item name="colorPrimaryContainer">@color/pal_amethyst_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/pal_amethyst_on_primary_container</item>
        <item name="colorSecondary">@color/pal_amethyst_secondary</item>
        <item name="colorOnSecondary">@color/pal_amethyst_on_secondary</item>
        <item name="colorSecondaryContainer">@color/pal_amethyst_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/pal_amethyst_on_secondary_container</item>
    </style>
</resources>
