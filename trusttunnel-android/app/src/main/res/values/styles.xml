<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme: Material 3 DayNight (auto light/dark).
        On Android 12+ DynamicColors overlays wallpaper-derived tones at runtime.
        The color attributes below serve as the fallback for older devices.
    -->
    <style name="Theme.FireTunnel" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fire_primary</item>
        <item name="colorOnPrimary">@color/fire_on_primary</item>
        <item name="colorPrimaryContainer">@color/fire_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/fire_on_primary_container</item>
        <item name="colorSecondary">@color/fire_secondary</item>
        <item name="colorOnSecondary">@color/fire_on_secondary</item>
        <item name="colorSecondaryContainer">@color/fire_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/fire_on_secondary_container</item>
    </style>
</resources>
